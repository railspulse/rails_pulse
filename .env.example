# Rails Pulse Development Environment Variables
# Copy this file to .env and customize the values for your local setup

# Database adapter to use for testing (default: sqlite3)
DB=sqlite3
# DB=postgresql
# DB=mysql2

# PostgreSQL Configuration (required when DB=postgresql)
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MySQL Configuration (required when DB=mysql2)
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Advanced test options
# FORCE_DB_CONFIG=true    # Force database reconfiguration at test runtime
# MEMORY_DATABASE=true    # Use in-memory SQLite for faster unit tests, ignored in CI
# PARALLEL_WORKERS=1      # Limit parallel test workers if DB connection issues occur
