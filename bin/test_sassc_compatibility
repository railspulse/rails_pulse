#!/usr/bin/env ruby
# frozen_string_literal: true

# Test script to verify Rails Pulse CSS compiles with SassC
# This simulates what happens when Sprockets processes our CSS

require_relative "../test/support/rails_pulse_console"

begin
  require "sassc"
rescue LoadError
  puts
  puts RailsPulseConsole.rule("SASSC COMPATIBILITY", nil, color: :red)
  puts
  puts RailsPulseConsole.line(:fail, "SassC gem not found")
  puts
  puts "  To test SassC compatibility, you need to install the sassc gem:"
  puts
  puts "    gem install sassc"
  puts
  puts "  Or test in your host app with:"
  puts
  puts "    cd ~/studiosity/eureka"
  puts "    bundle exec rake assets:precompile"
  puts
  exit 1
end

puts
puts RailsPulseConsole.rule("SASSC COMPATIBILITY", RailsPulseConsole.dim("Sprockets simulation"))
puts

css_file = File.expand_path("../vendor/assets/stylesheets/rails-pulse.css", __dir__)

unless File.exist?(css_file)
  puts RailsPulseConsole.line(:fail, "CSS file not found: #{css_file}")
  puts
  puts "  Please run: npm run build"
  exit 1
end

css_content = File.read(css_file)
file_size = (css_content.bytesize / 1024.0).round(1)

puts RailsPulseConsole.line(:ok, "#{File.basename(css_file)} #{RailsPulseConsole.dim("(#{file_size}KB)")}")

# Try to compile with SassC (simulating Sprockets behavior)
begin
  engine = SassC::Engine.new(css_content, {
    syntax: :scss,
    style: :compressed
  })

  result = engine.render
  output_size = (result.bytesize / 1024.0).round(1)

  puts RailsPulseConsole.line(:ok, "compiled with SassC #{RailsPulseConsole.dim("(#{output_size}KB output)")}")
  puts
  puts RailsPulseConsole.rule("PASS", "Rails Pulse CSS will work with Sprockets-based asset pipelines", color: :green)
  puts
rescue SassC::SyntaxError => e
  puts RailsPulseConsole.line(:fail, "SassC compilation failed")
  puts "        #{RailsPulseConsole.paint(e.message, :red)}"
  puts

  if e.message =~ /on line (\d+)/
    line_num = $1.to_i
    lines = css_content.lines
    start_line = [ line_num - 3, 0 ].max
    end_line = [ line_num + 2, lines.length - 1 ].min

    puts "  Problem area:"
    (start_line..end_line).each do |i|
      marker = (i == line_num - 1) ? RailsPulseConsole.paint(">>> ", :red) : "    "
      puts "  #{marker}#{i + 1}: #{lines[i]}"
    end
    puts
  end

  puts RailsPulseConsole.rule("FAIL", "this CSS will NOT work with Sprockets", color: :red)
  puts
  exit 1
end
