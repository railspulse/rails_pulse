#!/usr/bin/env bash
# frozen_string_literal: true

# publish_gem - Build and publish gem to RubyGems
#
# Usage:
#   bin/publish_gem
#   bin/publish_gem --help

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Help
if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  echo "Usage: bin/publish_gem"
  echo ""
  echo "Builds and publishes the gem to RubyGems.org"
  echo ""
  echo "Prerequisites:"
  echo "  - Assets must be built (npm run build)"
  echo "  - Must be authenticated with RubyGems (gem signin)"
  echo ""
  echo "This script will:"
  echo "  1. Verify assets are built"
  echo "  2. Build the gem package"
  echo "  3. Publish to RubyGems.org"
  echo ""
  echo "Example:"
  echo "  bin/publish_gem"
  exit 0
fi

echo -e "${BLUE}💎 Publishing Gem to RubyGems${NC}"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# Check if assets are built in both locations
PUBLIC_ASSETS="public/rails-pulse-assets"
VENDOR_CSS="vendor/assets/stylesheets"
VENDOR_JS="vendor/assets/javascripts"

ASSETS_MISSING=false

if [ ! -d "$PUBLIC_ASSETS" ] || [ -z "$(ls -A $PUBLIC_ASSETS 2>/dev/null)" ]; then
  echo -e "${YELLOW}⚠${NC}  Warning: Public assets directory is empty or missing ($PUBLIC_ASSETS)"
  ASSETS_MISSING=true
fi

if [ ! -d "$VENDOR_CSS" ] || [ -z "$(ls -A $VENDOR_CSS 2>/dev/null)" ]; then
  echo -e "${YELLOW}⚠${NC}  Warning: Vendor CSS directory is empty or missing ($VENDOR_CSS)"
  ASSETS_MISSING=true
fi

if [ ! -d "$VENDOR_JS" ] || [ -z "$(ls -A $VENDOR_JS 2>/dev/null)" ]; then
  echo -e "${YELLOW}⚠${NC}  Warning: Vendor JS directory is empty or missing ($VENDOR_JS)"
  ASSETS_MISSING=true
fi

if [ "$ASSETS_MISSING" = true ]; then
  echo ""
  echo "Run 'npm run build' to build assets first"
  read -p "Continue anyway? [y/N]: " -n 1 -r
  echo
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Aborted"
    exit 1
  fi
else
  echo -e "${GREEN}✓${NC} Assets found in $PUBLIC_ASSETS"
  echo -e "${GREEN}✓${NC} Assets found in $VENDOR_CSS"
  echo -e "${GREEN}✓${NC} Assets found in $VENDOR_JS"
fi

# Get version from version.rb (including pre-release suffix)
VERSION=$(grep 'VERSION = ' lib/rails_pulse/version.rb | sed 's/.*VERSION = "\(.*\)".*/\1/')
echo -e "Version: ${GREEN}v$VERSION${NC}"
echo ""

# Build gem
echo -e "${BLUE}⚙️  Building gem...${NC}"
gem build rails_pulse.gemspec

# Find the actual gem file that was built (RubyGems has complex naming rules)
GEM_FILE=$(ls -t rails_pulse-*.gem 2>/dev/null | head -1)

if [ -z "$GEM_FILE" ] || [ ! -f "$GEM_FILE" ]; then
  echo -e "${RED}❌ Error: No gem file found matching rails_pulse-*.gem${NC}"
  exit 1
fi

echo -e "  ${GREEN}✓${NC} Built: $GEM_FILE"
echo ""

# Show gem info
GEM_SIZE=$(ls -lh "$GEM_FILE" | awk '{print $5}')
echo "Gem file: $GEM_FILE ($GEM_SIZE)"
echo ""

# Publish to RubyGems
echo -e "${BLUE}↑ Publishing to RubyGems.org...${NC}"
echo ""

if gem push "$GEM_FILE"; then
  echo ""
  echo -e "${GREEN}✅ Gem published successfully!${NC}"
  echo ""
  echo "View on RubyGems: https://rubygems.org/gems/rails_pulse/versions/$VERSION"
  echo ""

  # Move gem to pkg directory
  mkdir -p pkg
  mv "$GEM_FILE" "pkg/$GEM_FILE"
  echo "Gem moved to: pkg/$GEM_FILE"
else
  echo ""
  echo -e "${RED}❌ Failed to publish gem${NC}"
  echo ""
  echo "Common issues:"
  echo "  • Not authenticated: Run 'gem signin'"
  echo "  • Version already exists: Bump version and try again"
  echo "  • Network issues: Check your connection"
  exit 1
fi
