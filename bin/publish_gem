#!/usr/bin/env bash
# frozen_string_literal: true

# publish_gem - Build and publish gem to RubyGems
#
# Usage:
#   bin/publish_gem
#   bin/publish_gem --help

set -e

source "$(dirname "${BASH_SOURCE[0]}")/lib/rails_pulse_console.sh"

# Help
if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  echo "Usage: bin/publish_gem"
  echo ""
  echo "Builds and publishes the gem to RubyGems.org"
  echo ""
  echo "Prerequisites:"
  echo "  - Assets must be built (npm run build)"
  echo "  - Must be authenticated with RubyGems (gem signin)"
  echo ""
  echo "This script will:"
  echo "  1. Verify assets are built"
  echo "  2. Build the gem package"
  echo "  3. Publish to RubyGems.org"
  echo ""
  echo "Example:"
  echo "  bin/publish_gem"
  exit 0
fi

# Get version from version.rb (including pre-release suffix)
VERSION=$(grep 'VERSION = ' lib/rails_pulse/version.rb | sed 's/.*VERSION = "\(.*\)".*/\1/')

echo
echo "$(rp_rule "PUBLISH GEM" "$(rp_dim "v$VERSION")")"
echo

# Check if assets are built in both locations
PUBLIC_ASSETS="public/rails-pulse-assets"
VENDOR_CSS="vendor/assets/stylesheets"
VENDOR_JS="vendor/assets/javascripts"

ASSETS_MISSING=false

for pair in "$PUBLIC_ASSETS:public assets" "$VENDOR_CSS:vendor CSS" "$VENDOR_JS:vendor JS"; do
  dir="${pair%%:*}"
  label="${pair##*:}"
  if [ ! -d "$dir" ] || [ -z "$(ls -A "$dir" 2>/dev/null)" ]; then
    rp_warn "$label directory is empty or missing ($dir)"
    ASSETS_MISSING=true
  else
    rp_ok "$label found in $dir"
  fi
done

if [ "$ASSETS_MISSING" = true ]; then
  echo
  echo "  Run 'npm run build' to build assets first"
  read -p "Continue anyway? [y/N]: " -n 1 -r
  echo
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "  Aborted"
    exit 1
  fi
fi

# Build gem
gem build rails_pulse.gemspec

# Find the actual gem file that was built (RubyGems has complex naming rules)
GEM_FILE=$(ls -t rails_pulse-*.gem 2>/dev/null | head -1)

if [ -z "$GEM_FILE" ] || [ ! -f "$GEM_FILE" ]; then
  rp_fail "no gem file found matching rails_pulse-*.gem"
  exit 1
fi

GEM_SIZE=$(ls -lh "$GEM_FILE" | awk '{print $5}')
rp_ok "built $GEM_FILE $(rp_dim "($GEM_SIZE)")"

# Publish to RubyGems
if gem push "$GEM_FILE"; then
  echo
  rp_ok "gem published successfully"
  echo
  echo "  View on RubyGems: https://rubygems.org/gems/rails_pulse/versions/$VERSION"

  # Move gem to pkg directory
  mkdir -p pkg
  mv "$GEM_FILE" "pkg/$GEM_FILE"
  echo "  Gem moved to: pkg/$GEM_FILE"
  echo
  echo "$(rp_rule "PASS" "" "$RP_GREEN")"
  echo
else
  echo
  rp_fail "failed to publish gem"
  echo
  echo "  Common issues:"
  echo "    - Not authenticated: Run 'gem signin'"
  echo "    - Version already exists: Bump version and try again"
  echo "    - Network issues: Check your connection"
  exit 1
fi
