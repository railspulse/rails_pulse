#!/usr/bin/env bash

# Rails Pulse Development Server
# Builds assets and starts the Rails server with optional adapter modes

set -e

# Parse arguments
VERBOSE=false
ADAPTER_MODE=""
RAILS_ARGS=()

for arg in "$@"; do
  case $arg in
    --verbose|-v)
      VERBOSE=true
      shift
      ;;
    --sync)
      ADAPTER_MODE="sync"
      shift
      ;;
    --sidecar)
      ADAPTER_MODE="sidecar"
      shift
      ;;
    --sidecar-tcp)
      ADAPTER_MODE="sidecar-tcp"
      shift
      ;;
    --help|-h)
      echo "Rails Pulse Development Server"
      echo ""
      echo "Usage: ./bin/dev [options] [rails server options]"
      echo ""
      echo "Options:"
      echo "  -v, --verbose      Show detailed output from asset building and watching"
      echo "  --sync             Use sync adapter (default, 5-6ms overhead)"
      echo "  --sidecar          Use sidecar adapter with UNIX socket (< 0.1ms overhead)"
      echo "  --sidecar-tcp      Use sidecar adapter with TCP (0.2-0.3ms overhead)"
      echo "  -h, --help         Show this help message"
      echo ""
      echo "Adapter Modes:"
      echo "  sync        - Direct database writes (default)"
      echo "  sidecar     - Separate process via UNIX socket (requires foreman/overmind)"
      echo "  sidecar-tcp - Separate process via TCP (easier debugging)"
      echo ""
      echo "Examples:"
      echo "  ./bin/dev                    # Start with sync adapter (default)"
      echo "  ./bin/dev --sidecar          # Start with sidecar adapter (UNIX socket)"
      echo "  ./bin/dev --sidecar-tcp      # Start with sidecar adapter (TCP)"
      echo "  ./bin/dev --verbose          # Start with detailed output"
      echo "  ./bin/dev -p 3001            # Start on port 3001"
      exit 0
      ;;
    *)
      RAILS_ARGS+=("$arg")
      shift
      ;;
  esac
done

echo "🚀 Starting Rails Pulse development server..."

# Determine which adapter mode to use
if [ -z "$ADAPTER_MODE" ]; then
  ADAPTER_MODE="sync"  # Default to sync
fi

# We're already in the Rails Pulse root directory
ROOT_DIR="$(pwd)"
DUMMY_DIR="$ROOT_DIR/test/dummy"

# Check if npm is available
if ! command -v npm &> /dev/null; then
  echo "❌ npm is required but not installed. Please install Node.js and npm."
  exit 1
fi

# Check if node_modules exists
if [ ! -d "node_modules" ]; then
  echo "📦 Installing npm dependencies..."
  if [ "$VERBOSE" = true ]; then
    npm install
  else
    npm install --silent
  fi
fi

# Start asset watching in background
if [ "$VERBOSE" = true ]; then
  echo "👀 Starting asset watcher..."
  RAILS_PULSE_VERBOSE=true npm run watch &
else
  echo "👀 Asset watcher started"
  npm run watch > /dev/null 2>&1 &
fi
WATCH_PID=$!

# Function to cleanup background processes
cleanup() {
  echo "🛑 Stopping asset watcher..."
  kill $WATCH_PID 2>/dev/null || true
  exit
}

# Trap cleanup on script exit
trap cleanup EXIT INT TERM

# Initial build
if [ "$VERBOSE" = true ]; then
  echo "🔨 Building Rails Pulse assets..."
  RAILS_PULSE_VERBOSE=true npm run build
else
  echo "🔨 Assets built successfully"
  npm run build > /dev/null 2>&1
fi

# Determine which mode to run
if [ "$ADAPTER_MODE" = "sync" ]; then
  # Sync mode - just run Rails server
  echo "📊 Adapter: SYNC (5-6ms overhead)"
  echo "🌐 Starting Rails server..."
  cd "$DUMMY_DIR"
  export RAILS_PULSE_ADAPTER=sync
  exec ./bin/rails server "${RAILS_ARGS[@]}"

elif [ "$ADAPTER_MODE" = "sidecar" ] || [ "$ADAPTER_MODE" = "sidecar-tcp" ]; then
  # Sidecar mode - use foreman to run both processes

  # Check if foreman is available
  if ! command -v foreman &> /dev/null; then
    echo "❌ foreman is required for sidecar mode but not installed."
    echo "   Install with: gem install foreman"
    echo "   Or use sync mode: ./bin/dev --sync"
    exit 1
  fi

  if [ "$ADAPTER_MODE" = "sidecar" ]; then
    echo "📊 Adapter: SIDECAR (< 0.1ms overhead, UNIX socket)"
    export RAILS_PULSE_ADAPTER=sidecar
    export RAILS_PULSE_SIDECAR_SOCKET=/tmp/rails_pulse.sock
    PROCFILE="$ROOT_DIR/Procfile.sidecar"
  else
    echo "📊 Adapter: SIDECAR (0.2-0.3ms overhead, TCP)"
    export RAILS_PULSE_ADAPTER=sidecar
    export RAILS_PULSE_SIDECAR_HOST=localhost
    export RAILS_PULSE_SIDECAR_PORT=3001
    PROCFILE="$ROOT_DIR/Procfile.sidecar.tcp"
  fi

  echo "🌐 Starting Rails server and sidecar..."
  exec foreman start -f "$PROCFILE"
else
  echo "❌ Unknown adapter mode: $ADAPTER_MODE"
  exit 1
fi
