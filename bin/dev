#!/usr/bin/env bash

# Rails Pulse Development Server
# Builds assets and starts the Rails server with optional tracking modes

set -e

# Parse arguments
VERBOSE=false
TRACKING_MODE=""
STANDALONE_DASHBOARD=false
RAILS_ARGS=()

for arg in "$@"; do
  case $arg in
    --verbose|-v)
      VERBOSE=true
      shift
      ;;
    --sync)
      TRACKING_MODE="sync"
      shift
      ;;
    --async)
      TRACKING_MODE="async"
      shift
      ;;
    --standalone)
      STANDALONE_DASHBOARD=true
      shift
      ;;
    --help|-h)
      echo "Rails Pulse Development Server"
      echo ""
      echo "Usage: ./bin/dev [options] [rails server options]"
      echo ""
      echo "Options:"
      echo "  -v, --verbose      Show detailed output from asset building and watching"
      echo "  --sync             Use sync mode (blocking, easier debugging)"
      echo "  --async            Use async mode (non-blocking, production-like)"
      echo "  --standalone       Run standalone dashboard on port 3001"
      echo "  -h, --help         Show this help message"
      echo ""
      echo "Tracking Modes:"
      echo "  sync        - Synchronous database writes (5-6ms overhead, data immediate)"
      echo "  async       - Background thread writes (~0.1ms overhead, data with tiny delay)"
      echo ""
      echo "Dashboard Modes:"
      echo "  default     - Dashboard embedded in main app"
      echo "  standalone  - Dashboard runs as separate process (production architecture)"
      echo ""
      echo "Examples:"
      echo "  ./bin/dev                    # Start with async mode (default)"
      echo "  ./bin/dev --sync             # Start with sync mode (for debugging)"
      echo "  ./bin/dev --async            # Start with async mode explicitly"
      echo "  ./bin/dev --standalone       # Run standalone dashboard only"
      echo "  ./bin/dev --verbose          # Start with detailed output"
      echo "  ./bin/dev -p 3001            # Start on port 3001"
      exit 0
      ;;
    *)
      RAILS_ARGS+=("$arg")
      shift
      ;;
  esac
done

echo "🚀 Starting Rails Pulse development server..."

# Determine which tracking mode to use
if [ -z "$TRACKING_MODE" ]; then
  TRACKING_MODE="async"  # Default to async (production-like)
fi

# We're already in the Rails Pulse root directory
ROOT_DIR="$(pwd)"
DUMMY_DIR="$ROOT_DIR/test/dummy"

# Check if npm is available
if ! command -v npm &> /dev/null; then
  echo "❌ npm is required but not installed. Please install Node.js and npm."
  exit 1
fi

# Check if node_modules exists
if [ ! -d "node_modules" ]; then
  echo "📦 Installing npm dependencies..."
  if [ "$VERBOSE" = true ]; then
    npm install
  else
    npm install --silent
  fi
fi

# Start asset watching in background (unless running standalone dashboard)
if [ "$STANDALONE_DASHBOARD" = false ]; then
  if [ "$VERBOSE" = true ]; then
    echo "👀 Starting asset watcher..."
    RAILS_PULSE_VERBOSE=true npm run watch &
  else
    echo "👀 Asset watcher started"
    npm run watch > /dev/null 2>&1 &
  fi
  WATCH_PID=$!

  # Function to cleanup background processes
  cleanup() {
    echo "🛑 Stopping asset watcher..."
    kill $WATCH_PID 2>/dev/null || true
    exit
  }

  # Trap cleanup on script exit
  trap cleanup EXIT INT TERM

  # Initial build
  if [ "$VERBOSE" = true ]; then
    echo "🔨 Building Rails Pulse assets..."
    RAILS_PULSE_VERBOSE=true npm run build
  else
    echo "🔨 Assets built successfully"
    npm run build > /dev/null 2>&1
  fi
fi

# Run in the appropriate mode
if [ "$STANDALONE_DASHBOARD" = true ]; then
  # Standalone dashboard mode
  echo "📊 Mode: STANDALONE DASHBOARD"
  echo "🌐 Starting standalone dashboard on port 3001..."
  echo ""
  echo "   The dashboard will read from the dummy app's database."
  echo "   Make sure to run the main app separately with:"
  echo "   ./bin/dev --async (or --sync)"
  echo ""

  # Point to dummy app's database
  export DATABASE_URL="sqlite3:$DUMMY_DIR/db/development.sqlite3"

  cd "$ROOT_DIR"
  exec bundle exec rackup lib/rails_pulse_server.ru -p 3001 -o 0.0.0.0

elif [ "$TRACKING_MODE" = "sync" ]; then
  # Sync mode - blocking writes
  echo "📊 Tracking Mode: SYNC"
  echo "   - Direct database writes (5-6ms overhead)"
  echo "   - Data available immediately"
  echo "   - Good for: development, debugging"
  echo ""
  echo "🌐 Starting Rails server..."
  cd "$DUMMY_DIR"
  export RAILS_PULSE_ASYNC=false
  exec ./bin/rails server "${RAILS_ARGS[@]}"

elif [ "$TRACKING_MODE" = "async" ]; then
  # Async mode - non-blocking writes
  echo "📊 Tracking Mode: ASYNC (default)"
  echo "   - Background thread writes (~0.1ms overhead)"
  echo "   - Data available with tiny delay (~0.1s)"
  echo "   - Good for: production, staging, most use cases"
  echo ""
  echo "🌐 Starting Rails server..."
  cd "$DUMMY_DIR"
  export RAILS_PULSE_ASYNC=true
  exec ./bin/rails server "${RAILS_ARGS[@]}"

else
  echo "❌ Unknown tracking mode: $TRACKING_MODE"
  exit 1
fi
