#!/usr/bin/env bash
# frozen_string_literal: true

# commit_release - Create git commit for version bump
#
# Usage:
#   bin/commit_release <version>
#   bin/commit_release --help

set -e

source "$(dirname "${BASH_SOURCE[0]}")/lib/rails_pulse_console.sh"

# Help
if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  echo "Usage: bin/commit_release <version>"
  echo ""
  echo "Creates a git commit for the version bump with:"
  echo "  - lib/rails_pulse/version.rb"
  echo "  - CHANGELOG.md (if modified)"
  echo "  - gemfiles/*.gemfile.lock"
  echo ""
  echo "Commit message: 'Bump version to vX.Y.Z'"
  echo ""
  echo "Example:"
  echo "  bin/commit_release 0.3.0"
  exit 0
fi

# Validate arguments
if [ -z "$1" ]; then
  rp_fail "version number required"
  echo "Usage: bin/commit_release <version>"
  echo "Run with --help for more information"
  exit 1
fi

VERSION="$1"

echo
echo "$(rp_rule "COMMIT RELEASE" "$(rp_dim "v$VERSION")")"
echo

# Check if there are changes to commit
if git diff --quiet HEAD lib/rails_pulse/version.rb CHANGELOG.md Gemfile.lock gemfiles/*.gemfile.lock 2>/dev/null; then
  rp_fail "no changes to commit"
  echo "Run bin/bump_version first to update version files"
  exit 1
fi

# Show what will be committed
echo "  Files to commit:"
git diff --name-only HEAD lib/rails_pulse/version.rb CHANGELOG.md Gemfile.lock gemfiles/*.gemfile.lock 2>/dev/null | sed 's/^/    - /'
echo

# Stage files
git add lib/rails_pulse/version.rb
git add CHANGELOG.md
git add Gemfile.lock
git add gemfiles/*.gemfile.lock

# Create commit
COMMIT_MSG="Bump version to v$VERSION"
git commit -m "$COMMIT_MSG"

echo
rp_ok "commit created: $(rp_dim "$COMMIT_MSG")"
echo
echo "$(rp_rule "PASS" "" "$RP_GREEN")"
echo
