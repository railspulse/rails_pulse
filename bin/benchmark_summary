#!/usr/bin/env ruby
# Benchmarks SummaryService with a production-like dataset.
# Run from the gem root: DB=postgresql bundle exec ruby bin/benchmark_summary
#
# Designed to be run on two branches to compare performance:
#   git checkout main              && DB=postgresql bundle exec ruby bin/benchmark_summary
#   git checkout improve-performance && DB=postgresql bundle exec ruby bin/benchmark_summary
#
# Dataset:
#   - 24 hours of background data (~172,800 requests, ~1.7M operations)
#   - 1 hour of current data to summarise (7,200 requests, 72,000 operations)
#   - 150 routes, 1,500 unique queries

require "benchmark"

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
ENV["RAILS_ENV"] ||= "test"
require File.expand_path("../test/dummy/config/environment", __dir__)

include RailsPulse

ROUTES                = 150
QUERIES               = 1_500
OPS_PER_REQUEST       = 10
CURRENT_HOUR_REQUESTS = 7_200
BACKGROUND_REQUESTS   = 165_600
RUNS                  = 3

def count_queries(&block)
  count = 0
  counter = ->(*, **) { count += 1 }
  ActiveSupport::Notifications.subscribed(counter, "sql.active_record", &block)
  count
end

def seed_data(current_hour_start)
  print "Clearing existing data... "
  Operation.delete_all
  Request.delete_all
  JobRun.delete_all
  Summary.delete_all
  Route.delete_all
  Query.delete_all
  puts "done"

  print "Creating #{ROUTES} routes and #{QUERIES} queries... "
  routes  = ROUTES.times.map  { |i| Route.create!(method: "GET", path: "/resource/#{i}/action") }
  queries = QUERIES.times.map { |i| Query.create!(hashed_sql: Digest::MD5.hexdigest("SELECT * FROM t#{i} WHERE id = ?"), normalized_sql: "SELECT * FROM t#{i} WHERE id = ?") }
  route_ids = routes.map(&:id)
  query_ids = queries.map(&:id)
  puts "done"

  print "Inserting #{BACKGROUND_REQUESTS} background requests... "
  background_start = current_hour_start - 23.hours
  bg_rows = BACKGROUND_REQUESTS.times.map do |i|
    occurred_at = background_start + (i * (23.0 * 3600 / BACKGROUND_REQUESTS)).seconds
    { route_id: route_ids[i % ROUTES], duration: rand(10.0..500.0).round(3),
      status: [200, 200, 200, 404, 500].sample, is_error: false,
      request_uuid: SecureRandom.uuid, controller_action: "ResourceController#show",
      occurred_at: occurred_at, created_at: occurred_at, updated_at: occurred_at }
  end
  bg_rows.each_slice(5_000) { |batch| Request.insert_all!(batch) }
  puts "done"

  print "Inserting background operations (~#{BACKGROUND_REQUESTS * OPS_PER_REQUEST / 1_000}k)... "
  Request.where("occurred_at < ?", current_hour_start).order(:id).pluck(:id).each_slice(2_000) do |ids|
    op_rows = ids.flat_map do |req_id|
      occurred_at = background_start + rand(23 * 3600).seconds
      OPS_PER_REQUEST.times.map do
        { request_id: req_id, query_id: query_ids.sample, operation_type: "database",
          label: "SELECT ...", duration: rand(1.0..50.0).round(3), start_time: 0.0,
          occurred_at: occurred_at, created_at: occurred_at, updated_at: occurred_at }
      end
    end
    Operation.insert_all!(op_rows)
  end
  puts "done"

  print "Inserting #{CURRENT_HOUR_REQUESTS} current-hour requests... "
  current_rows = CURRENT_HOUR_REQUESTS.times.map do |i|
    occurred_at = current_hour_start + (i * 0.5).seconds
    { route_id: route_ids[i % ROUTES], duration: rand(10.0..500.0).round(3),
      status: [200, 200, 200, 404, 500].sample, is_error: false,
      request_uuid: SecureRandom.uuid, controller_action: "ResourceController#show",
      occurred_at: occurred_at, created_at: occurred_at, updated_at: occurred_at }
  end
  Request.insert_all!(current_rows)
  puts "done"

  print "Inserting current-hour operations (~#{CURRENT_HOUR_REQUESTS * OPS_PER_REQUEST / 1_000}k)... "
  Request.where(occurred_at: current_hour_start..).order(:id).pluck(:id).each_slice(2_000) do |ids|
    op_rows = ids.flat_map do |req_id|
      occurred_at = current_hour_start + rand(3600).seconds
      OPS_PER_REQUEST.times.map do
        { request_id: req_id, query_id: query_ids.sample, operation_type: "database",
          label: "SELECT ...", duration: rand(1.0..50.0).round(3), start_time: 0.0,
          occurred_at: occurred_at, created_at: occurred_at, updated_at: occurred_at }
      end
    end
    Operation.insert_all!(op_rows)
  end
  puts "done"

  puts "\nTable sizes:"
  puts "  rails_pulse_requests:    #{Request.count.to_s.rjust(8)}"
  puts "  rails_pulse_operations:  #{Operation.count.to_s.rjust(8)}"
  puts "  Routes:                  #{Route.count.to_s.rjust(8)}"
  puts "  Queries:                 #{Query.count.to_s.rjust(8)}"
  puts
end

# ── run ───────────────────────────────────────────────────────────────────────

current_hour_start = 1.hour.ago.beginning_of_hour

branch = `git rev-parse --abbrev-ref HEAD`.strip
commit = `git rev-parse --short HEAD`.strip
puts "\nBranch: #{branch} (#{commit})"
puts "Ruby:   #{RUBY_VERSION} | Rails: #{Rails::VERSION::STRING} | DB: #{ApplicationRecord.connection.adapter_name}\n\n"

seed_data(current_hour_start)

times   = []
queries = []

RUNS.times do |i|
  Summary.delete_all
  print "Run #{i + 1}/#{RUNS}... "
  q = count_queries do
    t = Benchmark.measure { SummaryService.new("hour", current_hour_start).perform }
    times << t.real
  end
  queries << q
  puts "#{times.last.round(2)}s, #{q} queries"
end

avg = ->(arr) { arr.sum.to_f / arr.size }

puts
puts "=" * 50
puts "  Branch:      #{branch}"
puts "  Avg time:    #{avg.(times).round(2)}s"
puts "  Avg queries: #{avg.(queries).round}"
puts "=" * 50
