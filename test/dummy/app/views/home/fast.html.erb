<h1>Fast Queries</h1>
<p class="meta" style="margin-bottom: 20px;">Simple COUNT operations and basic record retrieval — minimal database load.</p>

<div class="grid-3">
  <div class="section">
    <h3>Quick Counts</h3>
    <ul>
      <li><strong>Users:</strong> <%= @total_users %></li>
      <li><strong>Posts:</strong> <%= @total_posts %></li>
    </ul>
  </div>

  <div class="section">
    <h3>Latest Post</h3>
    <% if @latest_post %>
      <p><strong><%= @latest_post.title %></strong></p>
      <p class="meta">By <%= @latest_post.user&.name || "Unknown" %> &middot; <%= time_ago_in_words(@latest_post.created_at) %> ago</p>
    <% else %>
      <p class="meta">No posts found.</p>
    <% end %>
  </div>

  <div class="section">
    <h3>Performance</h3>
    <ul>
      <li>Fast database queries</li>
      <li>Minimal processing</li>
      <li>Quick response expected</li>
    </ul>
  </div>
</div>
