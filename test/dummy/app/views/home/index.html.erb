<h1>Dashboard</h1>
<p class="meta" style="margin-bottom: 20px;">Executes joins, aggregations, subqueries, LIKE searches, and N+1 patterns to generate monitoring data.</p>

<div class="grid-2" style="margin-bottom: 16px;">
  <div class="section">
    <h2>Recent Users (<%= @recent_users.count %>)</h2>
    <% if @recent_users.any? %>
      <ul>
        <% @recent_users.each do |user| %>
          <li>
            <strong><%= user.name %></strong> &mdash; <%= pluralize(user.posts.count, "post") %>, <%= pluralize(user.comments.count, "comment") %>
            <br><span class="meta"><%= user.email %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="meta">No recent users.</p>
    <% end %>
  </div>

  <div class="section">
    <h2>Post Statistics by Author</h2>
    <% if @post_stats.any? %>
      <ul>
        <% @post_stats.each do |author, count| %>
          <li><%= author %>: <%= pluralize(count, "post") %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="meta">No statistics available.</p>
    <% end %>
  </div>

  <div class="section">
    <h2>Sample Posts</h2>
    <% if @search_results.any? %>
      <ul>
        <% @search_results.each do |post| %>
          <li>
            <strong><%= post.title %></strong> by <%= post.user&.name || "Unknown" %>
            <span class="meta">(<%= pluralize(post.comments.count, "comment") %>)</span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="meta">No posts found.</p>
    <% end %>
  </div>

  <div class="section">
    <h2>Popular Posts (2+ Comments)</h2>
    <% if @popular_posts.any? %>
      <ul>
        <% @popular_posts.each do |post| %>
          <li>
            <strong><%= post.title %></strong> by <%= post.user&.name || "Unknown" %>
            <span class="meta">(<%= pluralize(post.comments.count, "comment") %>)</span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="meta">No popular posts.</p>
    <% end %>
  </div>
</div>

<div class="section" style="margin-bottom: 16px;">
  <h2>Recent Posts</h2>
  <% if @paginated_posts.any? %>
    <div class="grid-auto">
      <% @paginated_posts.each do |post| %>
        <div class="card">
          <h4><%= post.title %></h4>
          <p class="meta">By <%= post.user&.name || "Unknown" %> &middot; <%= time_ago_in_words(post.created_at) %> ago</p>
          <p><%= truncate(post.content, length: 100) %></p>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="meta">No posts found.</p>
  <% end %>
</div>

<% if @featured_user %>
  <div class="section" style="margin-bottom: 16px;">
    <h2>Featured User</h2>
    <p><strong><%= @featured_user.name %></strong> (<%= @featured_user.email %>) &mdash; <%= pluralize(@user_post_count, "post") %></p>
  </div>
<% end %>

<div class="section">
  <h2>Activity Summary</h2>
  <ul>
    <li>Recent activity: <%= @has_recent_activity ? "Yes" : "No" %></li>
    <li>Authors: <%= @post_authors.join(", ") %></li>
  </ul>
</div>
