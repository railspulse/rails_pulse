<h1>Slow Queries</h1>
<p class="meta" style="margin-bottom: 20px;">Complex JOINs, GROUP BY, HAVING clauses, multiple subqueries, and bound-parameter lookups.</p>

<div style="display: grid; gap: 16px;">
  <div class="section">
    <h2>User Statistics (Complex Aggregation)</h2>
    <% if @user_stats.any? %>
      <div class="grid-auto">
        <% @user_stats.each do |user| %>
          <div class="card">
            <h4><%= user.name %></h4>
            <p class="meta"><%= user.email %></p>
            <p><strong><%= user.post_count %></strong> posts &middot; <strong><%= user.comment_count %></strong> comments</p>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="meta">No statistics available.</p>
    <% end %>
  </div>

  <div class="section">
    <h2>Text Search Results (Expensive)</h2>
    <% if @search_posts.any? %>
      <ul>
        <% @search_posts.each do |post| %>
          <li>
            <strong><%= post.title %></strong> by <%= post.author_name %>
            <span class="meta">(<%= post.comment_count %> comments)</span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="meta">No results found.</p>
    <% end %>
  </div>

  <div class="section">
    <h2>Active Users (Multiple Subqueries)</h2>
    <% if @active_users.any? %>
      <ul>
        <% @active_users.each do |user| %>
          <li><%= user.name %> <span class="meta">(<%= user.email %>)</span></li>
        <% end %>
      </ul>
    <% else %>
      <p class="meta">No active users found.</p>
    <% end %>
  </div>

  <% if @sample_user %>
    <div class="section">
      <h2>Bound Parameter Lookups (sample_binds)</h2>
      <p><strong>User #1:</strong> <%= @sample_user.name %> &mdash; <%= @sample_user.email %></p>
      <% if @sample_post %>
        <p><strong>Post #1:</strong> <%= @sample_post.title %></p>
      <% end %>
      <% if @user_posts&.any? %>
        <p><strong>Posts by user_id=<%= @sample_user.id %>:</strong></p>
        <ul>
          <% @user_posts.each do |post| %>
            <li><%= post.title %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  <% end %>
</div>
