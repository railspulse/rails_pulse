<h1>Search</h1>
<p class="meta" style="margin-bottom: 16px;">Case-insensitive LIKE searches, exact matches, and JOIN-based queries.</p>

<div style="margin-bottom: 20px;">
  <%= form_with url: search_path, method: :get, local: true, style: "display: flex; gap: 8px;" do |f| %>
    <%= f.text_field :q, value: params[:q], placeholder: "Search posts, users, comments…",
          style: "flex: 1; padding: 8px 10px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px;" %>
    <%= f.submit "Search",
          style: "padding: 8px 16px; background: #333; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-size: 14px;" %>
  <% end %>
</div>

<div style="display: grid; gap: 16px;">
  <div class="section">
    <h2>Statistics</h2>
    <div class="grid-3">
      <div class="card" style="text-align: center;">
        <div style="font-size: 24px; font-weight: 700;"><%= @search_stats[:total_posts] %></div>
        <div class="meta">Posts</div>
      </div>
      <div class="card" style="text-align: center;">
        <div style="font-size: 24px; font-weight: 700;"><%= @search_stats[:total_users] %></div>
        <div class="meta">Users</div>
      </div>
      <div class="card" style="text-align: center;">
        <div style="font-size: 24px; font-weight: 700;"><%= @search_stats[:total_comments] %></div>
        <div class="meta">Comments</div>
      </div>
    </div>
  </div>

  <div class="section">
    <h2>Post Results</h2>
    <% if @text_results.any? %>
      <div class="grid-auto">
        <% @text_results.each do |post| %>
          <div class="card">
            <h4><%= post.title %></h4>
            <p class="meta">By <%= post.user&.name || "Unknown" %> &middot; <%= post.comments.count %> comments</p>
            <p><%= truncate(post.content, length: 100) %></p>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="meta">No posts found.</p>
    <% end %>
  </div>

  <div class="section">
    <h2>User Results</h2>
    <% if @user_results.any? %>
      <ul>
        <% @user_results.each do |user| %>
          <li>
            <strong><%= user.name %></strong> &mdash; <%= pluralize(user.posts.count, "post") %>
            <span class="meta">(<%= user.email %>)</span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="meta">No users found.</p>
    <% end %>
  </div>

  <div class="section">
    <h2>Comment Results</h2>
    <% if @comment_results.any? %>
      <div style="display: grid; gap: 8px;">
        <% @comment_results.each do |comment| %>
          <div class="card">
            <p style="margin: 0 0 4px;"><%= comment.content %></p>
            <p class="meta">By <%= comment.user&.name %> on &ldquo;<%= comment.post&.title %>&rdquo;</p>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="meta">No comments found.</p>
    <% end %>
  </div>
</div>
