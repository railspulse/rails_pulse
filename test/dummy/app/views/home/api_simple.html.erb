<h1>API Simple</h1>
<p class="meta" style="margin-bottom: 20px;">Basic COUNT queries — fast response, minimal database load. Add <code>.json</code> to the URL for the raw JSON response.</p>

<div class="grid-2">
  <div class="section">
    <h2>Response Data</h2>
    <div style="background: #f9f9f9; padding: 14px; border-radius: 4px;">
      <pre><%= JSON.pretty_generate(@data) %></pre>
    </div>
  </div>

  <div class="section">
    <h2>Details</h2>
    <ul>
      <li><strong>Format:</strong> JSON</li>
      <li><strong>Complexity:</strong> Simple</li>
      <li><strong>Operations:</strong> Basic COUNT queries</li>
      <li><strong>Expected performance:</strong> Fast</li>
    </ul>
    <div style="margin-top: 16px;">
      <p><%= link_to "JSON response", api_simple_path(format: :json), style: "color: #333;" %></p>
    </div>
  </div>
</div>
