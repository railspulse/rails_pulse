<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rails Pulse Test App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags if defined?(Importmap) %>
    <style>
      * { box-sizing: border-box; }
      body { margin: 0; font-family: system-ui, sans-serif; font-size: 14px; color: #111; background: #fff; display: flex; min-height: 100vh; }
      nav { width: 200px; min-width: 200px; background: #f5f5f5; border-right: 1px solid #e0e0e0; display: flex; flex-direction: column; padding: 20px 0; }
      nav .brand { padding: 0 16px 16px; border-bottom: 1px solid #e0e0e0; margin-bottom: 12px; font-weight: 600; font-size: 13px; color: #333; }
      nav .brand span { display: block; font-weight: 400; font-size: 11px; color: #888; margin-top: 2px; }
      nav a { display: block; padding: 7px 16px; text-decoration: none; color: #444; font-size: 13px; }
      nav a:hover { background: #eaeaea; color: #111; }
main { flex: 1; padding: 28px 32px; overflow: auto; }
      h1 { font-size: 20px; margin: 0 0 6px; }
      h2 { font-size: 16px; margin: 0 0 12px; }
      h3 { font-size: 14px; margin: 0 0 10px; }
      h4 { font-size: 13px; margin: 0 0 8px; }
      .section { border: 1px solid #e0e0e0; border-radius: 6px; padding: 18px; }
      .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }
      .grid-auto { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; }
      .card { border: 1px solid #e8e8e8; border-radius: 4px; padding: 14px; }
      .meta { color: #666; font-size: 12px; }
      .note { background: #f9f9f9; border-radius: 4px; padding: 14px; margin-top: 16px; font-size: 13px; color: #555; }
      ul { margin: 0; padding-left: 18px; }
      li { margin-bottom: 4px; }
      pre { margin: 0; white-space: pre-wrap; font-size: 12px; }
      code { font-size: 12px; background: #f0f0f0; padding: 1px 4px; border-radius: 3px; }
    </style>
  </head>

  <body>
    <nav>
      <div class="brand">Rails Pulse<span>Test App</span></div>
      <%= link_to "Dashboard",   root_path,        data: { turbo_prefetch: "false" } %>
      <%= link_to "Fast Queries", fast_path,        data: { turbo_prefetch: "false" } %>
      <%= link_to "Slow Queries", slow_path,        data: { turbo_prefetch: "false" } %>
      <%= link_to "Errors",        errors_path,      data: { turbo_prefetch: "false" } %>
      <%= link_to "Search",       search_path,      data: { turbo_prefetch: "false" } %>
      <%= link_to "API Simple",   api_simple_path,  data: { turbo_prefetch: "false" } %>
      <%= link_to "API Complex",  api_complex_path, data: { turbo_prefetch: "false" } %>
      <%= link_to "Jobs",       jobs_path,            data: { turbo_prefetch: "false" } %>
      <%= link_to "Exceptions", exceptions_test_path, data: { turbo_prefetch: "false" } %>
      <%= link_to "Rails Pulse →", "/rails_pulse",  data: { turbo_prefetch: "false" }, style: "display: block; padding: 7px 16px; text-decoration: none; color: #444; font-size: 13px; font-weight: 600;" %>
    </nav>

    <main>
      <%= yield %>
    </main>
  </body>
</html>
