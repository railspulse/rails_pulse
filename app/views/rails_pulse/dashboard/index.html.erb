<div class="flex justify-end">
  <%= render 'rails_pulse/components/active_filters' %>
</div>

<div class="row">
  <% @requests_over_threshold_metric_cards.each do |card_data| %>
    <%= render 'rails_pulse/components/metric_card', { class: "grid-item block", data: card_data } %>
  <% end %>
  <%= render 'rails_pulse/components/metric_card', { class: "grid-item block", data: @percentile_response_times_metric_card } %>
  <%= render 'rails_pulse/components/metric_card', { class: "grid-item block", data: @request_count_totals_metric_card } %>
  <%= render 'rails_pulse/components/metric_card', { class: "grid-item block", data: @error_rate_per_route_metric_card } %>
</div>

<div class="row">
  <div class="grid-item">
    <%= render 'rails_pulse/components/panel', {
      title: 'Response Time Percentiles',
      card_classes: 'b-full',
      help_heading: 'Response Time Percentiles',
      help_text: 'This panel shows the 95th and 99th percentile response times in milliseconds for all HTTP requests. These percentiles represent the upper bounds that 95% and 99% of requests fall below, respectively. When a Service Level Objective is configured, a dashed red line shows the performance threshold.',
      actions: [{ url: routes_path, icon: 'external-link', title: 'View details', data: { turbo_frame: '_top' } }]
    } do %>
      <% if @response_time_percentiles_chart_data.present? %>
        <div class="chart-container chart-container--slim">
          <%= render_stimulus_chart(
            @response_time_percentiles_chart_data,
            type: 'line',
            id: "dashboard_response_time_percentiles_chart",
            height: "100%",
            options: line_chart_options(
              units: "ms"
            )
          ) %>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="grid-item">
    <%= render 'rails_pulse/components/panel', {
      title: 'Query Performance',
      card_classes: 'b-full',
      help_heading: 'Query Performance',
      help_text: 'This panel shows the 95th and 99th percentile query execution times in milliseconds for all database queries. These percentiles represent the upper bounds that 95% and 99% of queries fall below, respectively. When a Service Level Objective is configured, a dashed red line shows the performance threshold.',
      actions: [{ url: queries_path, icon: 'external-link', title: 'View details', data: { turbo_frame: '_top' } }]
    } do %>
      <% if @p95_response_time_chart_data.present? %>
        <div class="chart-container chart-container--slim">
          <%= render_stimulus_chart(
            @p95_response_time_chart_data,
            type: 'line',
            id: "dashboard_p95_response_time_chart",
            height: "100%",
            options: line_chart_options(
              units: "ms"
            )
          ) %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<div class="row">
  <div class="grid-item">
    <%= render 'rails_pulse/components/panel', {
      title: 'Slowest Routes This Week',
      help_heading: 'Slowest Routes',
      help_text: 'This panel shows the slowest routes in your application this week, including P95 response time and total request count.',
      actions: [{ url: routes_path, icon: 'external-link', title: 'View details', data: { turbo_frame: '_top' } }],
      card_classes: 'table-container'
    } do %>
      <%= render 'rails_pulse/components/table', table_data: @slow_routes_table_data %>
    <% end %>
  </div>
</div>

<div class="row">
  <div class="grid-item">
    <%= render 'rails_pulse/components/panel', {
      title: 'Slowest Queries This Week',
      help_heading: 'Slowest Queries',
      help_text: 'This panel shows the slowest database queries in your application this week, including P95 execution time and when they were last seen.',
      actions: [{ url: queries_path, icon: 'external-link', title: 'View details', data: { turbo_frame: '_top' } }],
      card_classes: 'table-container'
    } do %>
      <%= render 'rails_pulse/components/table', table_data: @slow_queries_table_data %>
    <% end %>
  </div>
</div>
