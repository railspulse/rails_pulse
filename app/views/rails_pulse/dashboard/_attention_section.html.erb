<% label_color = severity == "critical" ? "var(--color-negative)" : "#854d0e" %>
<% divider_color = severity == "critical" ? "color-mix(in srgb, var(--color-negative) 20%, transparent)" : "color-mix(in srgb, #eab308 30%, transparent)" %>
<% label_text = severity == "critical" ? "Critical" : "Warning" %>

<div style="display: flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0; <%= add_spacing ? "margin-top: 0.5rem;" : "" %> margin-bottom: 0.1rem;">
  <span style="font-size: 0.65em; font-weight: 700; letter-spacing: 0.05em; color: <%= label_color %>; text-transform: uppercase;"><%= label_text %></span>
  <span class="text-xs text-subtle">· <%= count %></span>
  <div style="flex: 1; height: 1px; background: <%= divider_color %>;"></div>
</div>

<% items.each do |item| %>
  <%= render "rails_pulse/dashboard/attention_item", item: item, severity: severity %>
<% end %>
