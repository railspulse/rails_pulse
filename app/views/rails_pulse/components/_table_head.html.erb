<thead>
  <tr>
    <% columns.each do |column| %>
      <th class="<%= column[:class] %>">
        <%# A column with no field (Tags) has nothing to sort by: ransack would
            emit q[s]=+asc and the controller's default order would apply. %>
        <% if column[:sortable] == false || column[:field].nil? %>
          <%= column[:label] %>
        <% else %>
          <% sort_params = {} %>
          <%# The zoom bar sends JS milliseconds, which TimeRange converts to seconds and
              removes from params; carry the request's own values so the next request
              converts them once, not twice. %>
          <% zoom_start_time = request.query_parameters["zoom_start_time"] %>
          <% zoom_end_time = request.query_parameters["zoom_end_time"] %>
          <% if zoom_start_time.is_a?(String) && zoom_end_time.is_a?(String) %>
            <% sort_params[:zoom_start_time] = zoom_start_time %>
            <% sort_params[:zoom_end_time] = zoom_end_time %>
          <% end %>
          <% sort_params[:selected_column_time] = params[:selected_column_time] if params[:selected_column_time].present? %>
          <%= sort_link @ransack_query, column[:field], column[:label],
            sort_params.merge(
              class: "flex items-center",
              data: {
                action: "click->rails-pulse--table-sort#updateUrl"
              }
            ) %>
        <% end %>
      </th>
    <% end %>
  </tr>
</thead>
