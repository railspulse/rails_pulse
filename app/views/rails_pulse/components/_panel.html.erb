<%
  title ||= nil
  help_heading ||= nil
  help_text ||= nil
  link_to ||= nil
  actions ||= nil
  card_classes ||= ""
  content_partial ||= nil
  series_toggles ||= []
  series_toggles_chart_id ||= nil
%>
<div class="card <%= card_classes %>">
  <div class="flex flex-col b-full">
    <div class="flex">
      <% if title %>
        <h2 class="grow font-semibold leading-none mbe-1 uppercase text-xs"><%= title %></h2>
      <% end %>
      <div class="panel-icon-bar flex gap items-center">
        <% series_toggles.each do |toggle| %>
          <button
            class="series-toggle"
            style="color: <%= toggle[:color] %>"
            data-active="true"
            data-controller="rails-pulse--series-toggle"
            data-rails-pulse--series-toggle-series-name-value="<%= toggle[:name] %>"
            data-rails-pulse--series-toggle-chart-id-value="<%= series_toggles_chart_id %>"
            data-action="click->rails-pulse--series-toggle#toggle"
          ><%= toggle[:name] %></button>
        <% end %>
        <% if help_heading %>
          <div data-controller="rails-pulse--popover" data-rails-pulse--popover-placement-value="bottom-start">
            <a href="#"
              data-rails-pulse--popover-target="button"
              data-action="rails-pulse--popover#toggle"
              data-popovertarget="popover">
              <%= rails_pulse_icon 'message-circle-question', height: "20px" %>
            </a>

            <div popover class="popover card" data-rails-pulse--popover-target="menu" style="max-width: 20rem">
              <div class="flex flex-col">
                <h3 class="font-semibold leading-none mbe-2 uppercase text-sm"><%= help_heading %></h3>
                <p class="text-sm text-subtle"><%= help_text %></p>
              </div>
            </div>
          </div>
        <% end %>
        <% if actions %>
          <% actions.each do |action| %>
            <% if action[:action] %>
              <%# Use a link with a Stimulus action for AJAX-style interactions %>
              <a
                href="#"
                title="<%= action[:title] || '' %>"
                class="<%= action[:class] || '' %>"
                data-action="<%= action[:action] %>"
                data-analyze-url="<%= action[:url] %>"
                <% if action[:data] %>
                  <% action[:data].each do |key, value| %>
                    data-<%= key.to_s.dasherize %>="<%= value %>"
                  <% end %>
                <% end %>
              >
                <%= rails_pulse_icon action[:icon] || 'external-link', height: "20px" %>
              </a>
            <% elsif action[:method] %>
              <%= button_to action[:url],
                           method: action[:method],
                           title: action[:title] || "",
                           class: action[:class] || "",
                           data: action[:data] || {} do %>
                <%= rails_pulse_icon action[:icon] || 'external-link', height: "20px" %>
              <% end %>
            <% else %>
              <%= link_to action[:url],
                         title: action[:title] || "",
                         class: action[:class] || "",
                         data: action[:data] || {} do %>
                <%= rails_pulse_icon action[:icon] || 'external-link', height: "20px" %>
              <% end %>
            <% end %>
          <% end %>
        <% elsif link_to %>
          <%= link_to link_to, title: "View details", class: "" do %>
            <%= rails_pulse_icon 'external-link', height: "20px" %>
          <% end %>
        <% end %>
      </div>
    </div>
    <% if content_partial %>
      <%= render content_partial %>
    <% else %>
      <%= yield %>
    <% end %>
  </div>
</div>
