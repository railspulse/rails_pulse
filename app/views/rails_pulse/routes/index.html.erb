<%= render 'rails_pulse/components/page_header', show_active_filters: true %>

<% unless turbo_frame_request? %>
  <% metric_cards = [
    *@requests_over_threshold_metric_cards,
    @percentile_response_times_metric_card,
    @request_count_totals_metric_card,
    @error_rate_per_route_metric_card
  ].compact %>
  <%= render 'rails_pulse/components/metric_strip', metrics_data: metric_cards %>
<% end %>

<div
  data-controller="rails-pulse--index"
  data-rails-pulse--index-chart-id-value="response_time_percentiles_chart"
>
  <%= render 'rails_pulse/components/panel', {
    title: 'Response Time Percentiles',
    card_classes: 'b-full',
    series_toggles: [
      { name: "P95", color: RailsPulse::ChartColors::P95 },
      { name: "P99", color: RailsPulse::ChartColors::P99 }
    ],
    series_toggles_chart_id: "response_time_percentiles_chart",
    help_heading: 'Response Time Percentiles',
    help_text: 'This panel shows the 95th and 99th percentile response times in milliseconds for all HTTP requests. These percentiles represent the upper bounds that 95% and 99% of requests fall below, respectively. When a Service Level Objective is configured, a dashed red line shows the performance threshold.'
  } do %>
    <%= search_form_for @ransack_query, url: routes_path, class: "flex items-center justify-between gap mb-4", data: { controller: "rails-pulse--custom-range" } do |form| %>
      <div class="flex items-center grow gap">
        <%= time_range_selector(form, time_range_options: RailsPulse::RoutesController::TIME_RANGE_OPTIONS, selected_time_range: @selected_time_range) %>
        <%= form.search_field :route_path_cont, placeholder: "Filter by route", autocomplete: "off", class: "input" %>
        <%= form.select :avg_duration,
          duration_options(:route),
          { selected: @selected_response_range },
          { class: "input" }
        %>
        <%= link_to "Reset", routes_path, class: "btn btn--borderless show@md" if params.has_key?(:q) %>
        <%= form.submit "Search", class: "btn show@sm" %>
      </div>
    <% end %>

    <% if @has_data %>
      <% if @chart_data && @chart_data[:series].present? %>
        <div
          class="chart-container chart-container--slim"
          data-rails-pulse--index-target="chart"
        >
          <%= render_stimulus_chart(
            @chart_data,
            type: 'line',
            id: "response_time_percentiles_chart",
            height: "100%",
            options: line_chart_options(
              units: "ms",
              zoom: true,
              xaxis_formatter: @xaxis_formatter,
              tooltip_formatter: @tooltip_formatter,
              zoom_start: @zoom_start,
              zoom_end: @zoom_end,
              chart_data: @chart_data
            )
          ) %>
        </div>
      <% end %>

      <%= turbo_frame_tag :index_table, data: { rails_pulse__index_target: "indexTable" } do %>
        <%= render 'rails_pulse/routes/table' %>
      <% end %>
    <% else %>
      <%= render 'rails_pulse/components/empty_state',
          title: 'No route data found for the selected filters.',
          description: 'Try adjusting your time range or filters to see results.' %>
    <% end %>
  <% end %>
</div>
