<%= render "rails_pulse/components/page_header", show_active_filters: true %>

<% unless turbo_frame_request? %>
  <% metric_cards = [
    @percentile_response_times_metric_card&.merge(link_url: routes_path(chart_type: "response_time")),
    @request_count_totals_metric_card&.merge(link_url: routes_path(chart_type: "request_rate")),
    @error_rates_metric_card&.merge(link_url: routes_path(chart_type: "error_rate")),
  ].compact %>
  <%= render "rails_pulse/components/metric_strip", metrics_data: metric_cards %>
<% end %>

<div
  data-controller="rails-pulse--index rails-pulse--chart-switcher"
  data-rails-pulse--index-chart-id-value="response_time_percentiles_chart"
  data-rails-pulse--chart-switcher-selected-value="response_time"
  data-action="
    rails-pulse--chart-switcher:switched->rails-pulse--index#handleChartSwitched
  "
>
  <%= render 'rails_pulse/components/panel', {
    title: 'Routes',
    card_classes: 'b-full',
    help_heading: 'Routes Performance Charts',
    help_text: 'Toggle between different performance metrics to analyze your routes. Response Time shows P95/P99 latency, Request Volume shows traffic patterns, and Error Rates track failure rates over time.'
  } do %>
    <%# Zone 2: Data filter bar %>
    <div class="filter-bar">
      <%= search_form_for @ransack_query, url: routes_path, class: "filter-bar__form" do |form| %>
        <input
          type="hidden"
          name="chart_type"
          data-rails-pulse--chart-switcher-target="chartTypeInput"
        >
        <%= form.search_field :route_path_cont,
                          placeholder: "Filter by route",
                          autocomplete: "off",
                          class: "input" %>
        <%= form.select :avg_duration,
                    duration_options(:route),
                    { selected: @selected_response_range },
                    { class: "input" } %>
        <%= if params.has_key?(:q)
          link_to "Reset",
          routes_path,
          class: "btn btn--plain",
          style: "text-decoration: none; color: var(--color-text-muted);"
        end %>
        <%= form.submit "Search", class: "btn" %>
      <% end %>
    </div>

    <%# Zone 1: Chart view selector %>
    <div class="panel-tabs">
      <div class="panel-tabs__list">
        <button
          class="panel-tab"
          data-chart-type="response_time"
          data-rails-pulse--chart-switcher-target="button"
          data-action="click->rails-pulse--chart-switcher#switch"
        >Response Time</button>
        <button
          class="panel-tab"
          data-chart-type="request_rate"
          data-rails-pulse--chart-switcher-target="button"
          data-action="click->rails-pulse--chart-switcher#switch"
        >Request Rate</button>
        <button
          class="panel-tab"
          data-chart-type="error_rate"
          data-rails-pulse--chart-switcher-target="button"
          data-action="click->rails-pulse--chart-switcher#switch"
        >Error Rate</button>
        <%# P50/P95/P99 toggles — only shown for Response Time %>
        <div
          data-rails-pulse--chart-switcher-target="toggleGroup"
          data-chart-type="response_time"
          class="panel-tabs__toggles"
          style="display: flex;"
        >
          <button
            class="series-toggle"
            style="color: <%= RailsPulse::ChartColors::DEFAULT %>"
            data-active="true"
            data-controller="rails-pulse--series-toggle"
            data-rails-pulse--series-toggle-series-name-value="P50"
            data-rails-pulse--series-toggle-chart-id-value="response_time_percentiles_chart"
            data-action="click->rails-pulse--series-toggle#toggle"
          >P50</button>
          <button
            class="series-toggle"
            style="color: <%= RailsPulse::ChartColors::P95 %>"
            data-active="true"
            data-controller="rails-pulse--series-toggle"
            data-rails-pulse--series-toggle-series-name-value="P95"
            data-rails-pulse--series-toggle-chart-id-value="response_time_percentiles_chart"
            data-action="click->rails-pulse--series-toggle#toggle"
          >P95</button>
          <button
            class="series-toggle"
            style="color: <%= RailsPulse::ChartColors::P99 %>"
            data-active="true"
            data-controller="rails-pulse--series-toggle"
            data-rails-pulse--series-toggle-series-name-value="P99"
            data-rails-pulse--series-toggle-chart-id-value="response_time_percentiles_chart"
            data-action="click->rails-pulse--series-toggle#toggle"
          >P99</button>
        </div>
        <%# 5xx/4xx toggles — only shown for Error Rates %>
        <div
          data-rails-pulse--chart-switcher-target="toggleGroup"
          data-chart-type="error_rate"
          class="panel-tabs__toggles"
          style="display: none;"
        >
          <button
            class="series-toggle"
            style="color: <%= RailsPulse::ChartColors::P95 %>"
            data-active="true"
            data-controller="rails-pulse--series-toggle"
            data-rails-pulse--series-toggle-series-name-value="5xx Errors"
            data-rails-pulse--series-toggle-chart-id-value="error_rate_chart"
            data-action="click->rails-pulse--series-toggle#toggle"
          >5xx</button>
          <button
            class="series-toggle"
            style="color: <%= RailsPulse::ChartColors::P99 %>"
            data-active="true"
            data-controller="rails-pulse--series-toggle"
            data-rails-pulse--series-toggle-series-name-value="4xx Errors"
            data-rails-pulse--series-toggle-chart-id-value="error_rate_chart"
            data-action="click->rails-pulse--series-toggle#toggle"
          >4xx</button>
        </div>
      </div>
    </div>

    <% if turbo_frame_request? %>
      <%= turbo_frame_tag :index_table, data: { rails_pulse__index_target: "indexTable" } do %>
        <%= render "rails_pulse/routes/table" %>
      <% end %>
    <% elsif @has_data %>
      <% if @has_chart_data %>
        <!-- Response Time Chart -->
        <div
          class="chart-container chart-container--slim"
          data-rails-pulse--index-target="chart"
          data-rails-pulse--chart-switcher-target="chart"
          data-chart-type="response_time"
          data-chart-id="response_time_percentiles_chart"
          style="display: block;"
        >
          <%= render_stimulus_chart(
            @response_time_chart_data,
            type: "line",
            id: "response_time_percentiles_chart",
            height: "100%",
            options:
              line_chart_options(
                units: "ms",
                zoom: true
              ),
          ) %>
        </div>
        <!-- Request Volume Chart -->
        <div
          class="chart-container chart-container--slim"
          data-rails-pulse--index-target="chart"
          data-rails-pulse--chart-switcher-target="chart"
          data-chart-type="request_rate"
          data-chart-id="request_rate_chart"
          style="display: none;"
        >
          <%= render_stimulus_chart(
            @request_rate_chart_data,
            type: "bar",
            id: "request_rate_chart",
            height: "100%",
            options:
              bar_chart_options(
                zoom: true
              ),
          ) %>
        </div>
        <!-- Error Rate Chart -->
        <div
          class="chart-container chart-container--slim"
          data-rails-pulse--index-target="chart"
          data-rails-pulse--chart-switcher-target="chart"
          data-chart-type="error_rate"
          data-chart-id="error_rate_chart"
          style="display: none;"
        >
          <%= render_stimulus_chart(
            @error_rate_chart_data,
            type: "bar",
            id: "error_rate_chart",
            height: "100%",
            options:
              bar_chart_options(
                units: "%",
                zoom: true
              ),
          ) %>
        </div>

      <% end %>

      <%= turbo_frame_tag :index_table, data: { rails_pulse__index_target: "indexTable" } do %>
        <%= render "rails_pulse/routes/table" %>
      <% end %>
    <% else %>
      <%= render "rails_pulse/components/empty_state",
      title: "No route data found for the selected filters.",
      description: "Try adjusting your time range or filters to see results." %>
    <% end %>
  <% end %>
</div>
