<%= render 'rails_pulse/components/page_header' %>

<% status_actions = [
     { label: "Resolve", url: exception_path(@exception_group), method: :patch, params: { status: "resolved" }, class: "btn", disabled: @exception_group.status == "resolved" },
     { label: "Ignore",  url: exception_path(@exception_group), method: :patch, params: { status: "ignored" },  class: "btn", disabled: @exception_group.status == "ignored" },
     { label: "Open",    url: exception_path(@exception_group), method: :patch, params: { status: "open" },     class: "btn", disabled: @exception_group.status == "open" },
     { label: @exception_group.preserve? ? "Unpreserve" : "Preserve",
       url: exception_path(@exception_group), method: :patch,
       params: { preserve: !@exception_group.preserve? }, class: "btn" }
   ] %>
<%= render 'rails_pulse/components/panel', title: 'Exception Details', actions: status_actions do %>
  <dl class="descriptive-list mbs-4">
    <dt>Class</dt>
    <dd><code><%= @exception_group.exception_class %></code></dd>
    <dt>Location</dt>
    <dd><code><%= @exception_group.location.presence || "—" %></code></dd>
    <dt>Message</dt>
    <dd><%= @exception_group.message.presence || "—" %></dd>
    <dt>Status</dt>
    <dd><%= render 'rails_pulse/exceptions/status_badge', group: @exception_group %></dd>
    <dt>First Seen</dt>
    <dd><%= human_readable_occurred_at(@exception_group.first_seen_at) %></dd>
    <dt>Last Seen</dt>
    <dd><%= human_readable_occurred_at(@exception_group.last_seen_at) %></dd>
    <dt>Total Seen</dt>
    <dd><%= number_with_delimiter(@exception_group.occurrence_count) %></dd>
    <dt>Stored Occurrences</dt>
    <dd><%= number_with_delimiter(@exception_group.occurrences.count) %></dd>
    <dt>Preserve</dt>
    <dd><%= @exception_group.preserve? ? "Yes — exempt from cleanup" : "No" %></dd>
  </dl>
<% end %>

<% if @latest_occurrence&.backtrace.present? %>
  <%= render 'rails_pulse/components/panel', title: 'Most Recent Backtrace' do %>
    <%= render 'rails_pulse/exceptions/backtrace', backtrace: @latest_occurrence.backtrace %>
  <% end %>
<% end %>

<%= render 'rails_pulse/components/panel', title: 'Occurrences' do %>
  <% if @occurrences.any? %>
    <%= render 'rails_pulse/exceptions/occurrences_table' %>
  <% else %>
    <%= render 'rails_pulse/components/empty_state',
        title: 'No occurrences found.',
        description: '' %>
  <% end %>
<% end %>
