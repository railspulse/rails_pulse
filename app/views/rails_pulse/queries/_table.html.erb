<% columns = [
  { field: :normalized_sql, label: 'Query', class: 'w-auto', cell_class: 'truncate-cell' },
  { field: :p95_duration_sort, label: 'P95', class: 'w-32' },
  { field: :p99_duration_sort, label: 'P99', class: 'w-32' },
  { field: :execution_count_sort, label: 'Executions', class: 'w-24' },
  { field: nil, label: 'Tags', class: 'w-32' }
] %>

<table class="table table-fixed mbs-4">
  <%= render "rails_pulse/components/table_head", columns: columns %>

  <tbody>
    <% @table_data.each do |summary| %>
      <tr>
        <td class="truncate-cell">
          <div>
            <%= link_to html_escape(truncate_sql(summary.normalized_sql)), query_path(summary.query_id) %>
          </div>
        </td>
        <td class="whitespace-nowrap"><%= summary.p95_duration.to_i %> ms</td>
        <td class="whitespace-nowrap"><%= summary.p99_duration.to_i %> ms</td>
        <td class="whitespace-nowrap"><%= number_with_delimiter summary.execution_count %></td>
        <td class="whitespace-nowrap"><%= display_tag_badges(summary.tags) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= render "rails_pulse/components/table_pagination" %>
