<%= render 'rails_pulse/components/page_header', show_active_filters: true %>

<% unless turbo_frame_request? %>
  <div class="row">
    <% @queries_over_threshold_metric_cards.each do |card_data| %>
      <%= render 'rails_pulse/components/metric_card', { class: "grid-item block", data: card_data } %>
    <% end %>
    <%= render 'rails_pulse/components/metric_card', { class: "grid-item block", data: @percentile_query_times_metric_card } %>
    <%= render 'rails_pulse/components/metric_card', { class: "grid-item block", data: @execution_rate_metric_card } %>
  </div>
<% end %>

<div
  data-controller="rails-pulse--index"
  data-rails-pulse--index-chart-id-value="query_performance_chart"
>
  <%= render 'rails_pulse/components/panel', {
    title: 'Query Performance',
    card_classes: 'b-full',
    help_heading: 'Query Performance',
    help_text: 'This panel shows the 95th and 99th percentile query execution times in milliseconds for all database queries. These percentiles represent the upper bounds that 95% and 99% of queries fall below, respectively. When a Service Level Objective is configured, a dashed red line shows the performance threshold.'
  } do %>
    <%= search_form_for @ransack_query, url: queries_path, class: "flex items-center justify-between gap mb-4", data: { controller: "rails-pulse--custom-range" } do |form| %>
      <div class="flex items-center grow gap">
        <%= time_range_selector(form, time_range_options: RailsPulse::QueriesController::TIME_RANGE_OPTIONS, selected_time_range: @selected_time_range) %>
        <%= form.select :avg_duration,
          duration_options(:query),
          { selected: @selected_response_range },
          { class: "input" }
        %>
        <%= link_to "Reset", queries_path, class: "btn btn--borderless show@md" if params.has_key?(:q) %>
        <%= form.submit "Search", class: "btn show@sm" %>
      </div>
    <% end %>

    <% if @has_data %>
      <% if @chart_data && @chart_data[:series].present? %>
        <div
          class="chart-container chart-container--slim"
          data-rails-pulse--index-target="chart"
        >
          <%= render_stimulus_chart(
            @chart_data,
            type: 'line',
            id: "query_performance_chart",
            height: "100%",
            options: line_chart_options(
              units: "ms",
              zoom: true,
              xaxis_formatter: @xaxis_formatter,
              tooltip_formatter: @tooltip_formatter,
              zoom_start: @zoom_start,
              zoom_end: @zoom_end,
              chart_data: @chart_data
            )
          ) %>
        </div>
      <% end %>

      <%= turbo_frame_tag :index_table, data: { rails_pulse__index_target: "indexTable" } do %>
        <%= render 'rails_pulse/queries/table' %>
      <% end %>
    <% else %>
      <%= render 'rails_pulse/components/empty_state',
          title: 'No query data found for the selected filters.',
          description: 'Try adjusting your time range or filters to see results.' %>
    <% end %>
  <% end %>
</div>
