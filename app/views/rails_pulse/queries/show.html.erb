<%= render 'rails_pulse/components/page_header', taggable: @query %>

<%= render "rails_pulse/queries/metric_cards" %>

<div
  data-controller="rails-pulse--index rails-pulse--chart-switcher"
  data-rails-pulse--index-chart-id-value="query_performance_chart"
  data-rails-pulse--chart-switcher-selected-value="query_performance"
  data-action="
    rails-pulse--chart-switcher:switched->rails-pulse--index#handleChartSwitched
  "
>
  <%= render 'rails_pulse/components/panel', { title: 'Query Responses' } do %>
    <div class="filter-bar">
      <%= search_form_for @ransack_query, url: query_path(@query), class: "filter-bar__form" do |form| %>
        <input
          type="hidden"
          name="chart_type"
          data-rails-pulse--chart-switcher-target="chartTypeInput"
        >
        <%= form.select :duration,
          duration_options(:query),
          { selected: @selected_response_range },
          { class: "input" }
        %>
        <%= link_to "Reset", query_path(@query), class: "btn btn--plain", style: "text-decoration: none; color: var(--color-text-muted);" if params.has_key?(:q) %>
        <%= form.submit "Search", class: "btn" %>
      <% end %>
    </div>

    <% unless turbo_frame_request? %>
      <% if @has_chart_data %>
        <%= render "rails_pulse/queries/chart_tabs" %>
      <% end %>
    <% end %>

    <%= turbo_frame_tag :index_table, data: { rails_pulse__index_target: "indexTable" } do %>
      <% if @table_data && @table_data.any? %>
        <%= render 'rails_pulse/queries/show_table' %>
      <% else %>
        <%= render 'rails_pulse/components/empty_state',
            title: 'No query responses found for the selected filters.',
            description: 'Try adjusting your time range or filters to see results.' %>
      <% end %>
    <% end %>
  <% end %>
</div>

<div class="mb-4">
  <%= render 'rails_pulse/components/code_panel', { title: 'Normalized Query', value: @query.normalized_sql } %>
</div>

<%= turbo_frame_tag "query_analysis", class: "mb-4" do %>
  <%= render 'rails_pulse/queries/analysis_section', query: @query %>
<% end %>

<%= render 'rails_pulse/components/panel', { title: 'Query Locations' } do %>
  <table class="table">
    <thead>
      <tr>
        <th>Location</th>
        <th>Average Query Time</th>
        <th>Count</th>
      </tr>
    </thead>
    <tbody>
      <% @query.operations.group_by(&:codebase_location).each do |codebase_location, operations| %>
        <tr>
          <td><%= codebase_location %></td>
          <td><%= (operations.sum(&:duration) / operations.count).round(2) %></td>
          <td><%= operations.count %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
