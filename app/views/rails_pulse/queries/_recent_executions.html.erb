<%= render 'rails_pulse/components/panel', { title: 'Recent Executions' } do %>
  <% if operations.any? %>
    <table class="table">
      <thead>
        <tr>
          <th>Time</th>
          <th class="w-32">Duration (ms)</th>
          <th class="w-24">Row Count</th>
          <th>Controller Action</th>
          <th class="w-32">N+1</th>
        </tr>
      </thead>
      <tbody>
        <% operations.each do |op| %>
          <tr>
            <td class="whitespace-nowrap text-sm text-subtle">
              <%= op.occurred_at.strftime("%b %d %H:%M:%S") %>
            </td>
            <td class="whitespace-nowrap">
              <%
                duration_class = case op.duration.to_f
                when 0..10 then "text-green-600"
                when 10..50 then "text-yellow-600"
                when 50..200 then "text-orange-600"
                else "text-red-600"
                end
              %>
              <span class="font-medium <%= duration_class %>"><%= op.duration.round(2) %></span>
            </td>
            <td class="text-center">
              <%= op.row_count || '—' %>
            </td>
            <td class="text-sm">
              <%= op.request&.controller_action || '—' %>
            </td>
            <td class="text-center">
              <% if op.repetition_count.present? %>
                <span class="badge badge--negative"><%= op.repetition_count %>×</span>
              <% else %>
                <span class="text-subtle">—</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <%= render 'rails_pulse/components/empty_state',
        title: 'No recent executions.',
        description: 'Executions will appear here as requests are tracked.' %>
  <% end %>
<% end %>
