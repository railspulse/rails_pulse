<% columns = [
  { field: :name, label: 'Job Class', class: 'w-48', cell_class: 'truncate-cell' },
  { field: :queue_name, label: 'Queue', class: 'w-32' },
  { field: :count_sort, label: 'Runs', class: 'w-28' },
  { field: :failures_count_sort, label: 'Failures', class: 'w-24' },
  { field: :p95_duration_sort, label: 'P95', class: 'w-32' },
  { field: :p99_duration_sort, label: 'P99', class: 'w-32' },
  { field: nil, label: 'Tags', class: 'w-32', sortable: false }
] %>

<table class="table table-fixed mbs-4" data-controller="rails-pulse--table-sort">
  <%= render "rails_pulse/components/table_head", columns: columns %>

  <tbody>
    <% @table_data.each do |row| %>
      <tr>
        <td class="truncate-cell">
          <%= link_to row.name, job_path(row.job_id), data: { turbo_frame: '_top' } %>
        </td>
        <td>
          <span class="badge badge--primary"><%= row.queue_name || 'default' %></span>
        </td>
        <td>
          <%= number_with_delimiter(row.count) %>
        </td>
        <td>
          <%= number_with_delimiter(row.error_count) %>
        </td>
        <td>
          <%= row.p95_duration ? "#{row.p95_duration.round(0)} ms" : "—" %>
        </td>
        <td>
          <%= row.p99_duration ? "#{row.p99_duration.round(0)} ms" : "—" %>
        </td>
        <td>
          <% tags = JSON.parse(row.tags || "[]") rescue [] %>
          <% if tags.any? %>
            <% tags.each do |tag| %>
              <span class="badge badge--secondary"><%= tag %></span>
            <% end %>
          <% else %>
            —
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= render "rails_pulse/components/table_pagination" %>
