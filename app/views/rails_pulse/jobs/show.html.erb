<%= render 'rails_pulse/components/page_header', taggable: @job %>

<%= render "rails_pulse/jobs/metric_cards" %>

<div
  data-controller="rails-pulse--index rails-pulse--chart-switcher"
  data-rails-pulse--index-chart-id-value="duration_chart"
  data-rails-pulse--chart-switcher-selected-value="duration"
  data-action="
    rails-pulse--chart-switcher:switched->rails-pulse--index#handleChartSwitched
  "
>
  <%= render 'rails_pulse/components/panel', {
    title: 'Job Runs',
    help_heading: 'Job Performance Charts',
    help_text: 'Toggle between different performance metrics for this job. Duration shows P95/P99 latency, Execution Volume shows execution frequency patterns, and Failure Rate tracks errors over time.'
  } do %>
    <div class="filter-bar">
      <%= search_form_for @ransack_query, url: job_path(@job), class: "filter-bar__form" do |form| %>
        <input
          type="hidden"
          name="chart_type"
          data-rails-pulse--chart-switcher-target="chartTypeInput"
        >
        <%= form.select :status_eq,
          options_for_select(
            [["All Statuses", ""]] + RailsPulse::JobRun::STATUSES.map { |s| [s.humanize, s] },
            params.dig(:q, :status_eq)
          ),
          {},
          { class: "input" }
        %>
        <%= form.select :duration_gteq,
          duration_threshold_filter_options(:job),
          { selected: params.dig(:q, :duration_gteq) },
          { class: "input" }
        %>
        <%= link_to "Reset", job_path(@job), class: "btn btn--plain", style: "text-decoration: none; color: var(--color-text-muted);" if params.has_key?(:q) %>
        <%= form.submit "Search", class: "btn" %>
      <% end %>
    </div>

    <% unless turbo_frame_request? %>
      <% if @has_chart_data %>
        <%= render "rails_pulse/jobs/chart_tabs" %>
      <% end %>
    <% end %>

    <%= turbo_frame_tag :index_table, data: { rails_pulse__index_target: "indexTable" } do %>
      <% if @table_data && @table_data.any? %>
        <%= render 'rails_pulse/jobs/job_runs_table' %>
      <% else %>
        <%= render 'rails_pulse/components/empty_state',
            title: 'No runs found for the selected filters.',
            description: 'Try adjusting your time range or filters to see results.' %>
      <% end %>
    <% end %>
  <% end %>
</div>
