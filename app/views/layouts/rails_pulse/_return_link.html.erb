<%# A way back to the host application. The standalone dashboard serves only
    Rails Pulse, so there is nothing to link back to there. %>
<% if RailsPulse.configuration.return_to_app_url.present? && !RailsPulse.standalone? %>
  <%= link_to RailsPulse.configuration.return_to_app_url, class: 'btn sidebar-menu__button sidebar-menu__button--return' do %>
    <%= rails_pulse_icon "arrow-left", width: "16" %>
    <span class="overflow-ellipsis">Back to <%= Rails.application.class.module_parent_name %></span>
  <% end %>
<% end %>
