<%# aria-current marks the section being viewed so the nav can highlight it. %>
<%# also: paths with no nav item of their own that belong to this section
    (Storage is opened from the dashboard, an operation from a request). %>
<% nav_current = ->(path, exact: false, also: []) {
     here = request.path.chomp("/")
     target = path.to_s.chomp("/")
     within = ->(prefix) { here == prefix || here.start_with?("#{prefix}/") }
     current = exact ? here == target : within.(target)
     (current || also.any? { |extra| within.(extra.to_s.chomp("/")) }) ? "page" : nil
   } %>
<%= link_to root_path, class: 'btn sidebar-menu__button', aria: { current: nav_current.(root_path, exact: true, also: [ storage_path ]) } do %>
  <%= rails_pulse_icon "layout-dashboard", width: "16" %>
  <span class="overflow-ellipsis">Dashboard</span>
<% end %>

<%= link_to routes_path, class: 'btn sidebar-menu__button', aria: { current: nav_current.(routes_path) } do %>
  <%= rails_pulse_icon "route", width: "16" %>
  <span class="overflow-ellipsis">Routes</span>
<% end %>

<%= link_to requests_path, class: 'btn sidebar-menu__button', aria: { current: nav_current.(requests_path, also: [ "#{root_path.chomp('/')}/operations" ]) } do %>
  <%= rails_pulse_icon "activity", width: "16" %>
  <span class="overflow-ellipsis">Requests</span>
<% end %>

<%= link_to queries_path, class: 'btn sidebar-menu__button', aria: { current: nav_current.(queries_path) } do %>
  <%= rails_pulse_icon "database", width: "16" %>
  <span class="overflow-ellipsis">Queries</span>
<% end %>

<% if RailsPulse.configuration.track_exceptions %>
  <%= link_to exceptions_path, class: 'btn sidebar-menu__button', aria: { current: nav_current.(exceptions_path) } do %>
    <%= rails_pulse_icon "alert-circle", width: "16" %>
    <span class="overflow-ellipsis">Exceptions</span>
  <% end %>
<% end %>

<% if RailsPulse.configuration.track_jobs %>
  <%= link_to jobs_path, class: 'btn sidebar-menu__button', aria: { current: nav_current.(jobs_path) } do %>
    <%= rails_pulse_icon "zap", width: "16" %>
    <span class="overflow-ellipsis">Jobs</span>
  <% end %>
<% end %>

<%= link_to deployments_path, class: 'btn sidebar-menu__button', aria: { current: nav_current.(deployments_path) } do %>
  <%= rails_pulse_icon "server", width: "16" %>
  <span class="overflow-ellipsis">Deployments</span>
<% end %>

<% RailsPulse.nav_items.each do |item| %>
  <%= link_to public_send(item[:path_helper]), class: 'btn sidebar-menu__button', aria: { current: nav_current.(public_send(item[:path_helper])) } do %>
    <%= rails_pulse_icon item[:icon], width: "16" %>
    <span class="overflow-ellipsis"><%= item[:label] %></span>
  <% end %>
<% end %>

<%= render 'layouts/rails_pulse/return_link' unless local_assigns[:skip_return_link] %>
