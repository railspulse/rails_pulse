<!DOCTYPE html>
<html data-color-scheme="light">
  <head>
    <title><%= content_for(:title) || page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <script nonce="<%= rails_pulse_csp_nonce %>">
      (function() {
        var storageKey = 'color-scheme';
        var root = document.documentElement;
        var scheme = 'light';

        try {
          var stored = localStorage.getItem(storageKey);
          if (stored === 'dark' || stored === 'light') {
            scheme = stored;
          } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            scheme = 'dark';
          }
        } catch (error) {
          if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            scheme = 'dark';
          }
        }

        root.setAttribute('data-color-scheme', scheme);

        // Restore the collapsed sidebar and the TUI look before first paint so
        // the page never renders one way and then snaps to the other.
        try {
          if (localStorage.getItem('rails-pulse-sidebar') === 'collapsed') {
            root.setAttribute('data-sidebar', 'collapsed');
          }
          if (localStorage.getItem('rails-pulse-ui') === 'tui') {
            root.setAttribute('data-ui', 'tui');
          }
        } catch (error) {}
      })();
    </script>

    <%# tag.link/script (not stylesheet_link_tag): middleware fallback paths must stay off asset_host. %>
    <%= tag.link rel: "stylesheet", href: rails_pulse.asset_path("rails-pulse.css") %>
    <%= tag.script "", src: rails_pulse.asset_path("rails-pulse-icons.js"), defer: true, nonce: rails_pulse_csp_nonce %>
    <%= tag.script "", src: rails_pulse.asset_path("rails-pulse.js"), defer: true, nonce: rails_pulse_csp_nonce %>
  </head>

  <body class="console-layout<%= ' console-layout--bare' unless @has_summaries %>">
    <% if @has_summaries %>
    <%# Persistent navigation on wide screens; narrower screens use the sheet
        opened from the top bar. %>
    <aside id="sidebar" class="show@xl" data-controller="rails-pulse--sidebar">
      <%= link_to rails_pulse.root_path, class: "console-brand", title: "Rails Pulse v#{RailsPulse::VERSION}" do %>
        <span class="console-brand__mark" aria-hidden="true"></span>
        <span class="console-brand__name">Rails Pulse</span>
        <span class="console-brand__version">v<%= RailsPulse::VERSION %></span>
      <% end %>

      <nav class="sidebar-menu__items console-nav" aria-label="Main">
        <span class="console-nav__label">Monitor</span>
        <%= render 'layouts/rails_pulse/menu_items', skip_return_link: true %>
      </nav>

      <div class="console-sidebar__footer sidebar-menu__items">
        <%= render 'layouts/rails_pulse/return_link' %>
        <div data-controller="rails-pulse--color-scheme">
          <%# Both states are rendered and the stylesheet shows the one for the
              current scheme, so the label is right on first paint. It names
              the mode a click switches to. %>
          <%= link_to '#', class: "btn sidebar-menu__button", role: "button", data: { action: "rails-pulse--color-scheme#toggle" } do %>
            <%= rails_pulse_icon 'moon', width: '16', class: "scheme-light-only" %>
            <span class="overflow-ellipsis scheme-light-only">Dark mode</span>
            <%= rails_pulse_icon 'sun', width: '16', class: "scheme-dark-only" %>
            <span class="overflow-ellipsis scheme-dark-only">Light mode</span>
          <% end %>
        </div>
        <div data-controller="rails-pulse--ui-mode">
          <button type="button" class="btn sidebar-menu__button console-sidebar__tui" aria-pressed="false" aria-label="Toggle terminal style" data-rails-pulse--ui-mode-target="toggle" data-action="rails-pulse--ui-mode#toggle">
            <%= rails_pulse_icon 'terminal', width: '16' %>
            <span class="overflow-ellipsis">TUI</span>
          </button>
        </div>
        <button type="button" class="btn sidebar-menu__button console-sidebar__collapse" aria-controls="sidebar" aria-expanded="true" aria-label="Collapse sidebar" data-rails-pulse--sidebar-target="toggle" data-action="rails-pulse--sidebar#toggle">
          <%= rails_pulse_icon 'chevrons-left', width: '16' %>
          <span class="overflow-ellipsis">Collapse</span>
        </button>
      </div>
    </aside>

    <header id="header">
      <div class="console-topbar__start">
        <div class="hide@xl" data-controller="rails-pulse--dialog">
          <button type="button" class="btn btn--icon btn--borderless" aria-label="Open menu" data-action="rails-pulse--dialog#showModal">
            <%= rails_pulse_icon 'menu', width: '18' %>
          </button>

          <dialog class="sheet sheet--left" style="--sheet-size: 288px;" data-rails-pulse--dialog-target="menu" data-action="click->rails-pulse--dialog#closeOnClickOutside">
            <div class="sheet__content p-2">
              <div class="sidebar-menu">
                <%= link_to rails_pulse.root_path, class: "console-brand" do %>
                  <span class="console-brand__mark" aria-hidden="true"></span>
                  <span class="console-brand__name">Rails Pulse</span>
                <% end %>
                <div class="sidebar-menu__content">
                  <div class="sidebar-menu__group">
                    <nav class="sidebar-menu__items">
                      <%= render 'layouts/rails_pulse/menu_items' %>
                    </nav>
                  </div>
                </div>
              </div>
            </div>
          </dialog>
        </div>

        <% topbar_title = breadcrumbs.last&.dig(:title)
           topbar_title = "Dashboard" if topbar_title.blank? || topbar_title == "Home" %>
        <span class="console-topbar__title"><%= topbar_title %></span>

        <% if content_for?(:topbar_status) %>
          <div class="console-topbar__status"><%= yield :topbar_status %></div>
        <% end %>
      </div>

      <div class="console-topbar__end">
        <%= render 'layouts/rails_pulse/time_range_selector' %>
        <%= render 'layouts/rails_pulse/global_filters' %>

        <%# The sidebar holds this toggle on wide screens; without one here a
            phone could not leave TUI mode once it was switched on. %>
        <div class="hide@xl" data-controller="rails-pulse--ui-mode">
          <%= link_to '#', "aria-label": "Toggle terminal style", "aria-pressed": "false", role: "button", data: { action: "rails-pulse--ui-mode#toggle", "rails-pulse--ui-mode-target": "toggle" } do %>
            <%= rails_pulse_icon 'terminal', width: '20' %>
          <% end %>
        </div>
        <div class="hide@xl" data-controller="rails-pulse--color-scheme">
          <%= link_to '#', "aria-label": "Switch between light and dark mode", role: "button", data: { action: "rails-pulse--color-scheme#toggle" } do %>
            <%= rails_pulse_icon 'moon', width: '20', class: "scheme-light-only" %>
            <%= rails_pulse_icon 'sun', width: '20', class: "scheme-dark-only" %>
          <% end %>
        </div>
      </div>
    </header>
    <% end %>

    <main id="main">
      <div class="container flex flex-col gap">
        <%= render 'layouts/rails_pulse/flash' %>
        <% if !@has_summaries %>
          <%= render 'layouts/rails_pulse/setup_screen' %>
        <% else %>
          <%= render 'layouts/rails_pulse/onboarding_banner' %>
          <%= yield %>
        <% end %>
      </div>
    </main>
  </body>
</html>
